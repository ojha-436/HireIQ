# --- Auth (two separate audiences; generate with: openssl rand -hex 32) ---
JWT_SECRET=dev-candidate-secret-change-me
EMPLOYER_JWT_SECRET=dev-employer-secret-change-me
JWT_TTL_HOURS=12

# --- Database ---
DATABASE_URL=sqlite:///./dev.db

# --- AI Interview (Phase 2+) ---
GEMINI_API_KEY=
# Text reasoning (analyst, report prose, moderator tiebreak)
GEMINI_MODEL=gemini-3.8-flash
# Live voice. Must be a NATIVE-AUDIO model: half-cascade Live models (e.g.
# gemini-3.1-flash-live-preview) run STT->LLM->TTS internally and hurt barge-in latency.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Agora RESTful credentials — required for Conversational AI.
# Console path: Developer Toolkit -> RESTful API -> Add a secret -> Download.
# ACCOUNT-level, not inside a project. The secret downloads only once.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# auto = Agora ConvoAI TTS when credentials exist, else Gemini Live native audio
VOICE_PROVIDER=auto

# --- Retention / internal cron ---
INTERVIEW_TURN_TTL_DAYS=60
DIGEST_TOKEN=dev-cron-token

# --- App ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
